---
const currentYear = new Date().getFullYear();
---
<footer class="bg-gray-900 text-gray-400 py-12">
    <div class="max-w-6xl mx-auto px-4 text-center">
        <div class="mb-8">
            <h2 class="text-2xl font-bold text-white mb-2">Jardinería Tavo</h2>
            <p>Expertos en áreas verdes y paisajismo.</p>
        </div>
        
        <div class="flex justify-center space-x-6 mb-8">
            <a href="#" class="hover:text-white transition">Inicio</a>
            <a href="#servicios" class="hover:text-white transition">Servicios</a>
            <a href="#galeria" class="hover:text-white transition">Galería</a>
            <a href="#contacto" class="hover:text-white transition">Contacto</a>
        </div>
        
        <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center text-sm">
            <p>&copy; {currentYear} Jardinería Tavo. Todos los derechos reservados.</p>
            <div class="mt-4 md:mt-0 flex space-x-4">
                <span>Desarrollado con ❤️ y Astro</span>
            </div>
        </div>
    </div>
</footer>
