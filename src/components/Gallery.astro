---
const images = [
    { src: "https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?q=80&w=800&auto=format&fit=crop", alt: "Jardín con flores" },
    { src: "https://images.unsplash.com/photo-1598902108854-10e335adac99?q=80&w=800&auto=format&fit=crop", alt: "Césped perfecto" },
    { src: "https://images.unsplash.com/photo-1592150621344-c90ef2b07a8b?q=80&w=800&auto=format&fit=crop", alt: "Paisajismo moderno" },
    { src: "https://images.unsplash.com/photo-1558905734-b83d944369e8?q=80&w=800&auto=format&fit=crop", alt: "Herramientas de jardinería" },
    { src: "https://images.unsplash.com/photo-1416870262648-255ae9260371?q=80&w=800&auto=format&fit=crop", alt: "Huerto urbano" },
    { src: "https://images.unsplash.com/photo-1523348837708-15d4a09cfac2?q=80&w=800&auto=format&fit=crop", alt: "Poda de arbustos" }
];
---
<section id="galeria" class="py-20 bg-green-50/50">
    <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-green-900 mb-4">Nuestra Galería</h2>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">Echa un vistazo a algunos de nuestros proyectos más recientes y deja que nuestro trabajo hable por sí mismo.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {images.map(image => (
                <div class="overflow-hidden rounded-xl shadow-md aspect-video group">
                    <img 
                        src={image.src} 
                        alt={image.alt} 
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                    />
                </div>
            ))}
        </div>
    </div>
</section>
