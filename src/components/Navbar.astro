---
// Navbar.astro
---
<nav class="bg-green-700/95 dark:bg-gray-900/95 backdrop-blur-sm text-white shadow-md fixed w-full top-0 left-0 z-50 transition-colors duration-300">
    <div class="w-full flex justify-between items-center px-3 py-1.5">
        
        <!-- SECCIÓN CLIMA Y FECHA BLINDADA PARA iOS -->
        <div class="flex-1 overflow-hidden mr-2 flex items-center">
            <div class="w-full text-white/95 text-xs sm:text-sm md:text-lg font-medium whitespace-nowrap overflow-hidden relative">
                <!-- Usamos dos veces el texto idéntico para crear un bucle continuo perfecto que Safari no puede romper -->
                <div id="marquee-track" class="inline-block whitespace-nowrap">
                    <span id="clima-ticker-1">Consultando fecha y clima... 🌤️</span>
                    <span id="clima-ticker-2" class="ml-12">Consultando fecha y clima... 🌤️</span>
                </div>
            </div>
        </div>

        <ul class="flex space-x-6 font-medium hidden md:flex items-center shrink-0 px-4">
            <li><a href="#" class="hover:text-green-200 transition">Inicio</a></li>
            <li><a href="#servicios" class="hover:text-green-200 transition">Servicios</a></li>
            <li><a href="#testimonios" class="hover:text-green-200 transition">Testimonios</a></li>
            <li><a href="#cobertura" class="hover:text-green-200 transition">Cobertura</a></li>
            <li><a href="#contacto" class="hover:text-green-200 transition border-2 border-white/30 px-4 py-1 rounded-full hover:bg-white hover:text-green-700 transition-all text-sm">Contacto</a></li>
        </ul>
        
        <!-- Grupo de botones derecho -->
        <div class="flex items-center shrink-0">
            <!-- BOTÓN MODO NOCHE (ESCRITORIO) -->
            <button id="theme-toggle" class="text-xl p-1.5 hover:scale-110 transition-transform focus:outline-none" aria-label="Cambiar tema">
                <span id="theme-icon">🌙</span>
            </button>

            <!-- Botón móvil -->
            <button id="menu-btn" class="md:hidden text-xl focus:outline-none p-1.5 ml-1" aria-label="Abrir menú">
                ☰
            </button>
        </div>
    </div>

    <!-- Menú móvil desplegable -->
    <div id="mobile-menu" class="hidden md:hidden pt-2 pb-2 border-t border-green-600 dark:border-gray-700 px-4 bg-green-800 dark:bg-gray-800 transition-colors duration-300">
        <ul class="flex flex-col space-y-1.5 font-medium text-center">
            <li><a href="#" class="block py-1.5 hover:bg-green-700 dark:hover:bg-gray-700 rounded transition text-sm">Inicio</a></li>
            <li><a href="#servicios" class="block py-1.5 hover:bg-green-700 dark:hover:bg-gray-700 rounded transition text-sm">Servicios</a></li>
            <li><a href="#testimonios" class="block py-1.5 hover:bg-green-700 dark:hover:bg-gray-700 rounded transition text-sm">Testimonios</a></li>
            <li><a href="#cobertura" class="block py-1.5 hover:bg-green-700 dark:hover:bg-gray-700 rounded transition text-sm">Cobertura</a></li>
            <li><a href="#contacto" class="block py-1.5 hover:bg-green-700 dark:hover:bg-gray-700 rounded transition text-sm">Contacto</a></li>
            
            <!-- SWITCH DE MODO OSCURO CENTRADO Y COMPACTO -->
            <li class="pt-2 mt-1 border-t border-green-600/60 dark:border-gray-700 flex justify-center">
                <div class="w-full max-w-[180px] flex items-center justify-between px-3 py-1 bg-green-900/30 dark:bg-gray-700/30 rounded-lg">
                    <span class="text-xs font-medium">Modo Oscuro</span>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="theme-switch-mobile" class="sr-only peer">
                        <div class="w-8 h-4 bg-gray-500 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-green-500"></div>
                        <span id="theme-switch-label" class="ml-2 text-[10px] font-bold uppercase w-4 text-left">Off</span>
                    </label>
                </div>
            </li>
        </ul>
    </div>
</nav>

<style>
    /* Bucle infinito real simétrico sin saltos en Safari */
    .animate-marquee-ios-perfect {
        display: inline-block;
        animation: scrollMarquee 30s linear infinite;
        -webkit-animation: scrollMarquee 30s linear infinite;
    }
    @keyframes scrollMarquee {
        0% { transform: translate3d(0, 0, 0); }
        100% { transform: translate3d(-50%, 0, 0); }
    }
    @-webkit-keyframes scrollMarquee {
        0% { transform: translate3d(0, 0, 0); }
        100% { transform: translate3d(-50%, 0, 0); }
    }
</style>

<script>
    // Lógica Sincronizada del Modo Noche (Escritorio y Switch Móvil)
    const themeToggleBtn = document.getElementById('theme-toggle');
    const themeSwitchMobile = document.getElementById('theme-switch-mobile');
    const themeSwitchLabel = document.getElementById('theme-switch-label');
    const themeIcon = document.getElementById('theme-icon');

    function actualizarUI(isDark) {
        if (isDark) {
            if(themeIcon) themeIcon.textContent = '☀️';
            if(themeSwitchMobile) themeSwitchMobile.checked = true;
            if(themeSwitchLabel) themeSwitchLabel.textContent = 'On';
        } else {
            if(themeIcon) themeIcon.textContent = '🌙';
            if(themeSwitchMobile) themeSwitchMobile.checked = false;
            if(themeSwitchLabel) themeSwitchLabel.textContent = 'Off';
        }
    }

    // Estado inicial al cargar la página
    const isDarkInitial = document.documentElement.classList.contains('dark');
    actualizarUI(isDarkInitial);

    function alternarTema() {
        document.documentElement.classList.toggle('dark');
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
            localStorage.setItem('theme', 'dark');
        } else {
            localStorage.setItem('theme', 'light');
        }
        actualizarUI(isDark);
    }

    themeToggleBtn?.addEventListener('click', alternarTema);
    themeSwitchMobile?.addEventListener('change', alternarTema);

    // Lógica Menú Móvil
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => { menu?.classList.toggle('hidden'); });
    menu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => { menu?.classList.add('hidden'); });
    });

    // Función para convertir el código de Open-Meteo en un emoji considerando si es de día o de noche
    function obtenerEmojiClima(code, isDay) {
        if (isDay === 0) {
            switch (code) {
                case 0: return '🌙'; 
                case 1:
                case 2: return '🌙☁️'; 
                case 3: return '☁️'; 
                case 51:
                case 53:
                case 55:
                case 61:
                case 63:
                case 65: return '🌧️'; 
                default: return '🌙';
            }
        }

        switch (code) {
            case 0: return '☀️'; 
            case 1:
            case 2: return '⛅'; 
            case 3: return '☁️'; 
            case 45:
            case 48: return '🌫️'; 
            case 51:
            case 53:
            case 55:
            case 56:
            case 57: return '🌧️'; 
            case 61:
            case 63:
            case 65:
            case 66:
            case 67: return '🌧️'; 
            case 71:
            case 73:
            case 75:
            case 77: return '❄️'; 
            case 80:
            case 81:
            case 82: return '🌦'; 
            case 95:
            case 96:
            case 99: return '⚡'; 
            default: return '🌤';
        }
    }

    // Lógica Clima y Fecha con año incluido y bucle continuo en iPhone
    async function cargarClimaYFecha() {
        try {
            let fecha = new Date().toLocaleDateString('es-CL', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
            fecha = fecha.charAt(0).toUpperCase() + fecha.slice(1);
            
            const respuesta = await fetch('https://api.open-meteo.com/v1/forecast?latitude=-36.05&longitude=-71.77&current_weather=true');
            const datos = await respuesta.json();
            
            const temp = Math.round(datos.current_weather.temperature);
            const weatherCode = datos.current_weather.weathercode;
            const isDay = datos.current_weather.is_day;
            const emojiClima = obtenerEmojiClima(weatherCode, isDay);
            
            const texto = `Fecha: ${fecha} &nbsp;&nbsp;|&nbsp;&nbsp; Clima: Retiro: ${temp + 1}°C ${emojiClima} &nbsp;&nbsp;|&nbsp;&nbsp; Copihue: ${temp + 1}°C ${emojiClima} &nbsp;&nbsp;|&nbsp;&nbsp; Parral: ${temp}°C ${emojiClima} &nbsp;&nbsp;|&nbsp;&nbsp; Longaví: ${temp}°C ${emojiClima} &nbsp;&nbsp;|&nbsp;&nbsp; Linares: ${temp}°C ${emojiClima}`;
            
            const ticker1 = document.getElementById('clima-ticker-1');
            const ticker2 = document.getElementById('clima-ticker-2');
            const track = document.getElementById('marquee-track');
            
            if (ticker1) ticker1.innerHTML = texto;
            if (ticker2) ticker2.innerHTML = texto;
            
            if (track) {
                track.classList.add('animate-marquee-ios-perfect');
            }
        } catch (error) {
            const ticker1 = document.getElementById('clima-ticker-1');
            const ticker2 = document.getElementById('clima-ticker-2');
            const track = document.getElementById('marquee-track');
            const fallback = "🌱 Clima ideal para cuidar tu jardín &nbsp;&nbsp;|&nbsp;&nbsp; 🌱 Clima ideal para cuidar tu jardín";
            if (ticker1) ticker1.innerHTML = fallback;
            if (ticker2) ticker2.innerHTML = fallback;
            if (track) track.classList.add('animate-marquee-ios-perfect');
        }
    }
    cargarClimaYFecha();
</script>