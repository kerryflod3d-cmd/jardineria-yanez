---
const services = [
    {
        title: "Mantenimiento de Césped",
        description: "Corte, fertilización y aireación para un verde impecable durante todo el año.",
        icon: "🌿🌱",
        images: ["/fotos/cesped-1.jpg",  "/fotos/cesped-2.jpg", "/fotos/cesped-3.jpg"] 
    },
    {
        title: "Poda Ornamental",
        description: "Cuidado especializado de arbustos y árboles para un crecimiento saludable y controlable de manera proactiva y eficaz.",
        icon: "🌳✂️",
        images: ["/fotos/poda-1.jpg", "/fotos/poda-2.jpg", "/fotos/poda-3.jpg", "/fotos/poda-4.jpg"]
    },
    {
        title: "Retiro de Sarmientos y Escombros",
        description: "Retiro de ramas, restos de construcción, demolición y muebles.",
        icon: "🚛🌿",
        images: ["/fotos/escombros-1.jpg",  "/fotos/escombros-2.jpg", "/fotos/escombros-3.jpg"]        
    },
    {
        title: "Tala de Árboles",
        description: "Talar, destrozar y picar árboles de manera segura y eficiente, respetando las medidas de seguridad.",
        icon: "🪵🪓",
        images: ["/fotos/tala-1.jpg",  "/fotos/tala-2.jpg", "/fotos/tala-3.jpg"]
    },
    {
        title: "Limpieza y Perfilado",
        description: "Limpieza profunda, chapeo de veredas y despeje de senderos para un acabado perfecto.",
        icon: "🚮🧹",
        images: ["/fotos/limpieza-1.jpg",  "/fotos/limpieza-2.jpg", "/fotos/limpieza-3.jpg"]
    }
];
---

<section id="servicios" class="py-20 bg-white dark:bg-gray-900 transition-colors duration-300 relative">
    <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-green-900 dark:text-green-400 mb-4">Nuestros Servicios</h2>
            <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">Ofrecemos soluciones integrales para el cuidado de tus áreas verdes con profesionalismo y dedicación.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {services.map(service => (
                <div class="p-6 border border-green-100 dark:border-gray-800 rounded-2xl hover:shadow-xl transition-shadow bg-[#F5F5DC] dark:bg-gray-800 flex flex-col group">
                    
                    <!-- Carrusel de Imágenes -->
                    <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 mb-6 pb-2 no-scrollbar">
                        {service.images.map(img => (
                            <img 
                                src={img} 
                                alt={service.title} 
                                class="h-64 w-auto max-w-full mx-auto rounded-xl snap-center shrink-0 shadow-md cursor-pointer hover:opacity-90 transition-opacity zoomable-image"
                            />
                        ))}
                    </div>

                    <div class="text-4xl mb-4 group-hover:scale-110 transition-transform inline-block origin-left">{service.icon}</div>
                    <h3 class="text-xl font-bold text-green-800 dark:text-green-300 mb-3">{service.title}</h3>
                    <p class="text-gray-700 dark:text-gray-300 leading-relaxed flex-grow">{service.description}</p>
                </div>
            ))}
        </div>
    </div>

    <!-- MODAL (Pantalla negra para ver fotos en grande) -->
    <div id="imageModal" class="fixed inset-0 z-[100] hidden bg-black/95 flex items-center justify-center p-4 opacity-0 transition-opacity duration-300 select-none">
        <button id="closeModal" class="absolute top-4 right-4 md:top-8 md:right-8 text-white text-5xl hover:text-green-400 focus:outline-none transition-colors z-[110]">&times;</button>
        <button id="prevBtn" class="absolute left-2 md:left-8 top-1/2 -translate-y-1/2 text-white hover:text-green-400 focus:outline-none transition-colors z-[110] p-2 hidden">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-10 h-10 md:w-14 md:h-14">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
        </button>
        <img id="modalImage" src="" alt="Imagen ampliada" class="max-w-full max-h-[90vh] object-contain rounded-xl shadow-2xl scale-95 transition-transform duration-300" />
        <button id="nextBtn" class="absolute right-2 md:right-8 top-1/2 -translate-y-1/2 text-white hover:text-green-400 focus:outline-none transition-colors z-[110] p-2 hidden">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-10 h-10 md:w-14 md:h-14">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
        </button>
    </div>
</section>

<style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
    const modal = document.getElementById('imageModal');
    const modalImg = document.getElementById('modalImage');
    const closeBtn = document.getElementById('closeModal');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const images = document.querySelectorAll('.zoomable-image');

    let currentGroup: HTMLImageElement[] = [];
    let currentIndex = 0;

    images.forEach(img => {
        img.addEventListener('click', (e) => {
            const carousel = (e.target as HTMLElement).closest('.no-scrollbar');
            if(carousel) {
                // Forzamos a que TypeScript reconozca cada elemento como HTMLImageElement
                currentGroup = Array.from(carousel.querySelectorAll('.zoomable-image')) as HTMLImageElement[];
                currentIndex = currentGroup.indexOf(img as HTMLImageElement);
            }

            if (currentGroup.length > 1) {
                prevBtn?.classList.remove('hidden');
                nextBtn?.classList.remove('hidden');
            } else {
                prevBtn?.classList.add('hidden');
                nextBtn?.classList.add('hidden');
            }

            if(modalImg instanceof HTMLImageElement && img instanceof HTMLImageElement) {
                modalImg.src = img.src;
                modal?.classList.remove('hidden');
                setTimeout(() => {
                    modal?.classList.remove('opacity-0');
                    modalImg.classList.remove('scale-95');
                    modalImg.classList.add('scale-100');
                }, 10);
            }
        });
    });

    const showImage = (index: number) => {
        if (currentGroup.length === 0) return;
        if (index < 0) index = currentGroup.length - 1;
        if (index >= currentGroup.length) index = 0;
        
        currentIndex = index;
        if(modalImg instanceof HTMLImageElement && currentGroup[currentIndex]) {
            modalImg.src = currentGroup[currentIndex].src;
        }
    };

    prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); showImage(currentIndex - 1); });
    nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); showImage(currentIndex + 1); });

    const closeModal = () => {
        modal?.classList.add('opacity-0');
        modalImg?.classList.remove('scale-100');
        modalImg?.classList.add('scale-95');
        setTimeout(() => {
            modal?.classList.add('hidden');
            if(modalImg instanceof HTMLImageElement) modalImg.src = '';
            currentGroup = [];
        }, 300);
    };

    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e) => {
        if (!modal?.classList.contains('hidden')) {
            if (e.key === 'Escape') closeModal();
            if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
            if (e.key === 'ArrowRight') showImage(currentIndex + 1);
        }
    });

    let touchStartX = 0;
    let touchEndX = 0;
    modal?.addEventListener('touchstart', (e) => { touchStartX = (e as TouchEvent).changedTouches[0].screenX; }, { passive: true });
    modal?.addEventListener('touchend', (e) => {
        touchEndX = (e as TouchEvent).changedTouches[0].screenX;
        const threshold = 50;
        if (touchStartX - touchEndX > threshold) showImage(currentIndex + 1);
        if (touchEndX - touchStartX > threshold) showImage(currentIndex - 1);
    }, { passive: true });
</script>