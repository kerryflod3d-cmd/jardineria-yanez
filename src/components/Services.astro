---
const services = [
    {
        title: "Mantenimiento de Césped",
        description: "Corte, fertilización y aireación para un verde impecable durante todo el año.",
        icon: "🌱"
    },
    {
        title: "Diseño de Paisajismo",
        description: "Creamos espacios armoniosos que reflejan tu estilo y se adaptan a tu entorno.",
        icon: "🎨"
    },
    {
        title: "Sistemas de Riego",
        description: "Instalación y reparación de sistemas automatizados para optimizar el uso del agua.",
        icon: "💧"
    },
    {
        title: "Poda y Limpieza",
        description: "Cuidado especializado de árboles y arbustos para un crecimiento saludable.",
        icon: "✂️"
    }
];
---
<section id="servicios" class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-green-900 mb-4">Nuestros Servicios</h2>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">Ofrecemos soluciones integrales para el cuidado de tus áreas verdes con profesionalismo y dedicación.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            {services.map(service => (
                <div class="p-8 border border-green-100 rounded-2xl hover:shadow-xl transition-shadow bg-green-50/30 group">
                    <div class="text-4xl mb-6 group-hover:scale-110 transition-transform inline-block">{service.icon}</div>
                    <h3 class="text-xl font-bold text-green-800 mb-3">{service.title}</h3>
                    <p class="text-gray-600 leading-relaxed">{service.description}</p>
                </div>
            ))}
        </div>
    </div>
</section>
