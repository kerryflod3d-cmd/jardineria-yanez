---
const services = [
    {
        title: "Mantenimiento de Césped",
        description: "Corte, fertilización y aireación para un verde impecable durante todo el año.",
        icon: "🌿🌱",
        images: ["/fotos/cesped-1.jpg",  "/fotos/cesped-2.jpg", "/fotos/cesped-3.jpg"] 
    },
    {
        title: "Poda Ornamental",
        description: "Cuidado especializado de arbustos y árboles para un crecimiento saludable y controlable de manera proactiva y eficaz.",
        icon: "🌳✂️",
        images: ["/fotos/poda-1.jpg", "/fotos/poda-2.jpg", "/fotos/poda-3.jpg", "/fotos/poda-4.jpg"]
    },
    {
        title: "Retiro de Sarmientos y Escombros",
        description: "Retiro de ramas, restos de construcción, demolición y muebles.",
        icon: "🚛🌿",
        images: ["/fotos/escombros-1.jpg",  "/fotos/escombros-2.jpg", "/fotos/escombros-3.jpg"]        
    },
    {
        title: "Tala de Árboles",
        description: "Tala, destrozar y picar árboles de manera segura y eficiente, respetando las medidas de seguridad.",
        icon: "🪵🪓",
        images: ["/fotos/tala-1.jpg",  "/fotos/tala-2.jpg", "/fotos/tala-3.jpg"]
    },
    {
        title: "Limpieza y Perfilado",
        description: "Limpieza profunda, chapeo de veredas y despeje de senderos para un acabado perfecto.",
        icon: "🚮🧹",
        images: ["/fotos/limpieza-1.jpg",  "/fotos/limpieza-2.jpg", "/fotos/limpieza-3.jpg"]
    }
];
---

<section id="servicios" class="py-20 bg-white relative">
    <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-green-900 mb-4">Nuestros Servicios</h2>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">Ofrecemos soluciones integrales para el cuidado de tus áreas verdes con profesionalismo y dedicación.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {services.map(service => (
                <div class="p-6 border border-green-100 rounded-2xl hover:shadow-xl transition-shadow bg-[#F5F5DC] flex flex-col group">
                    
                    <!-- Carrusel de Imágenes -->
                    <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 mb-6 pb-2 no-scrollbar">
                        {service.images.map(img => (
                            <img 
                                src={img} 
                                alt={service.title} 
                                /* Agregué cursor-pointer, hover:scale-105 y la clase zoomable-image */
                                class="h-64 w-auto max-w-full mx-auto rounded-xl snap-center shrink-0 shadow-md cursor-pointer hover:opacity-90 transition-opacity zoomable-image"
                            />
                        ))}
                    </div>

                    <div class="text-4xl mb-4 group-hover:scale-110 transition-transform inline-block origin-left">{service.icon}</div>
                    <h3 class="text-xl font-bold text-green-800 mb-3">{service.title}</h3>
                    <p class="text-gray-700 leading-relaxed flex-grow">{service.description}</p>
                </div>
            ))}
        </div>
    </div>

    <!-- MODAL (Pantalla negra oculta para agrandar imágenes) -->
    <div id="imageModal" class="fixed inset-0 z-[100] hidden bg-black/90 flex items-center justify-center p-4 opacity-0 transition-opacity duration-300">
        <button id="closeModal" class="absolute top-4 right-4 md:top-8 md:right-8 text-white text-5xl hover:text-green-400 focus:outline-none transition-colors">&times;</button>
        <img id="modalImage" src="" alt="Imagen ampliada" class="max-w-full max-h-[90vh] object-contain rounded-xl shadow-2xl scale-95 transition-transform duration-300" />
    </div>
</section>

<style>
    /* Clases personalizadas para ocultar la barra de desplazamiento */
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<script>
    // Lógica para abrir y cerrar el Modal de imágenes
    const modal = document.getElementById('imageModal');
    const modalImg = document.getElementById('modalImage');
    const closeBtn = document.getElementById('closeModal');
    const images = document.querySelectorAll('.zoomable-image');

    // Función para abrir la imagen
    images.forEach(img => {
        img.addEventListener('click', () => {
            if(modalImg instanceof HTMLImageElement && img instanceof HTMLImageElement) {
                modalImg.src = img.src;
                modal?.classList.remove('hidden');
                
                // Pequeño retraso para que la animación fluya suavemente
                setTimeout(() => {
                    modal?.classList.remove('opacity-0');
                    modalImg.classList.remove('scale-95');
                    modalImg.classList.add('scale-100');
                }, 10);
            }
        });
    });

    // Función para cerrar la imagen
    const closeModal = () => {
        modal?.classList.add('opacity-0');
        modalImg?.classList.remove('scale-100');
        modalImg?.classList.add('scale-95');
        
        // Espera a que termine la animación antes de ocultar el div
        setTimeout(() => {
            modal?.classList.add('hidden');
            if(modalImg instanceof HTMLImageElement) modalImg.src = '';
        }, 300);
    };

    // Cerrar con el botón X
    closeBtn?.addEventListener('click', closeModal);

    // Cerrar al hacer clic en el fondo negro (fuera de la foto)
    modal?.addEventListener('click', (e) => {
        if (e.target === modal) {
            closeModal();
        }
    });

    // Cerrar con la tecla "Escape" del teclado
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
            closeModal();
        }
    });
</script>