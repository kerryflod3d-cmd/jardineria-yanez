---
const testimonials = [
    {
        name: "María Ortega",
        role: "Dueña de Casa",
        text: "Estoy muy contenta por su trabajo, transformó mi patio trasero en un lugar increíble. Su atención al detalle es excepcional.",
        stars: 5
    },
    {
        name: "Juan Pérez",
        role: "Administrador de Condominio",
        text: "Llevamos un año trabajando con ellos para el mantenimiento de las áreas comunes y siempre cumplen con lo prometido.",
        stars: 5
    },
    {
        name: "Sofía Ramirez",
        role: "Cliente Particular",
        text: "Muy profesionales y puntuales. Recomiendo totalmente sus servicios de poda ornamental y los diseños que hace son muy peculiares.",
        stars: 4
    }
];
---
<!-- Fondo blanco de día, gris muy oscuro de noche -->
<section id="testimonios" class="py-20 bg-white dark:bg-gray-900 transition-colors duration-300">
    <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-12">
            <h2 class="text-4xl font-bold text-green-900 dark:text-green-400 mb-4">Lo que dicen nuestros clientes</h2>
            <p class="text-lg text-gray-600 dark:text-gray-300">La satisfacción de quienes confían en nosotros es nuestra mejor carta de presentación.</p>
        </div>

        <!-- CONTENEDOR DE RESEÑAS: SCROLL HORIZONTAL EN MÓVIL, GRID EN ESCRITORIO -->
        <div class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-8 md:grid md:grid-cols-3 md:overflow-visible md:snap-none hide-scrollbar">
            {testimonials.map(testimonial => (
                <div class="w-[85vw] sm:w-[350px] shrink-0 snap-center md:w-auto md:shrink flex flex-col justify-between p-8 bg-green-50/20 dark:bg-gray-800 border border-green-100 dark:border-gray-700 rounded-2xl relative transition-colors duration-300 shadow-sm">
                    <div>
                        <div class="flex text-yellow-500 mb-4">
                            {Array.from({ length: testimonial.stars }).map((_, i) => (
                                <span>⭐</span>
                            ))}
                        </div>
                        <p class="text-gray-700 dark:text-gray-300 italic mb-6">"{testimonial.text}"</p>
                    </div>
                    <div>
                        <p class="font-bold text-green-900 dark:text-green-300">{testimonial.name}</p>
                        <p class="text-sm text-green-700 dark:text-green-400">{testimonial.role}</p>
                    </div>
                </div>
            ))}
        </div>

        <!-- APARTADO PARA SUBIR UNA NUEVA RESEÑA -->
        <div class="mt-16 max-w-2xl mx-auto bg-green-50 dark:bg-gray-800/50 p-8 rounded-2xl shadow-sm border border-green-200 dark:border-gray-700 transition-colors duration-300">
            <div class="text-center mb-6">
                <h3 class="text-2xl font-bold text-green-900 dark:text-green-400">Déjanos tu opinión</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">¿Trabajamos en tu jardín? Cuéntanos tu experiencia.</p>
            </div>

            <form id="review-form" class="space-y-4">
                <!-- Selector de Estrellas Interactivo -->
                <div class="flex justify-center space-x-2 text-3xl cursor-pointer" id="star-rating">
                    <span data-value="1" class="star text-yellow-500 transition-colors">★</span>
                    <span data-value="2" class="star text-yellow-500 transition-colors">★</span>
                    <span data-value="3" class="star text-yellow-500 transition-colors">★</span>
                    <span data-value="4" class="star text-yellow-500 transition-colors">★</span>
                    <span data-value="5" class="star text-yellow-500 transition-colors">★</span>
                </div>
                <input type="hidden" name="rating" id="rating-value" value="5">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <input type="text" id="review-name" placeholder="Tu Nombre" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-green-500" required>
                    <input type="text" id="review-role" placeholder="Servicio (ej. Poda, Diseño)" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-green-500" required>
                </div>
                
                <textarea id="review-text" placeholder="Escribe tu reseña aquí..." rows="4" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-green-500 resize-none" required></textarea>
                
                <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-lg transition-colors shadow-md">
                    Enviar Reseña
                </button>
            </form>
        </div>
    </div>
</section>

<!-- ESTILOS PARA OCULTAR LA BARRA DE SCROLL FEA EN MÓVIL -->
<style>
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<!-- SCRIPT PARA LAS ESTRELLAS Y EL FORMULARIO -->
<script>
    const stars = document.querySelectorAll('.star');
    const ratingInput = document.getElementById('rating-value') as HTMLInputElement;
    const reviewForm = document.getElementById('review-form') as HTMLFormElement;

    // Lógica para marcar las estrellas al hacer clic
    stars.forEach(star => {
        star.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            const value = target.getAttribute('data-value');
            if (value && ratingInput) {
                ratingInput.value = value;
                updateStars(parseInt(value));
            }
        });
    });

    function updateStars(value: number) {
        stars.forEach(star => {
            const starValue = parseInt(star.getAttribute('data-value') || '0');
            if (starValue <= value) {
                star.classList.remove('text-gray-300', 'dark:text-gray-600');
                star.classList.add('text-yellow-500');
            } else {
                star.classList.remove('text-yellow-500');
                star.classList.add('text-gray-300', 'dark:text-gray-600');
            }
        });
    }

    // Manejo del envío del formulario
    reviewForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        
        // Aquí capturamos los datos. 
        // Como es una página estática, puedes enviarlos por WhatsApp, Formspree, o un correo.
        const name = (document.getElementById('review-name') as HTMLInputElement).value;
        const role = (document.getElementById('review-role') as HTMLInputElement).value;
        const text = (document.getElementById('review-text') as HTMLTextAreaElement).value;
        const rating = ratingInput.value;

        alert(`¡Gracias ${name}! Tu reseña de ${rating} estrellas ha sido registrada. (Nota: Conectar a base de datos o correo).`);
        
        // Limpiar formulario tras enviar
        reviewForm.reset();
        updateStars(5);
    });
</script>