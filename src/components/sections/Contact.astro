---
import { site, whatsappUrl } from '../../config/site';
import { services } from '../../data/services';
---
<section id="contacto" class="bg-[#0f512c] py-18 text-white sm:py-24" aria-labelledby="contact-title">
  <div class="container-site grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
    <div>
      <h2 id="contact-title" class="max-w-lg text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">¿Listo para renovar tu espacio?</h2>
      <p class="mt-6 max-w-xl text-lg leading-8 text-emerald-50">Contáctanos hoy mismo para tener asesoría personalizada y así obtener el 1er. Presupuesto totalmente gratis. Estamos ansiosos por ayudarte a crear el jardín de tus sueños.</p>
      <div class="mt-9 space-y-4 text-base sm:text-lg">
        <a href={`tel:${site.phoneE164}`} class="flex items-center gap-4 hover:underline"><span aria-hidden="true" class="text-xl">📞</span>{site.phoneLabel}</a>
        <p class="flex items-center gap-4"><span aria-hidden="true" class="text-xl">📍</span>Retiro, Región del Maule</p>
      </div>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-gradient-to-r from-amber-400 via-pink-500 to-purple-600 px-6 py-3 text-sm font-bold text-white shadow-lg hover:opacity-90 sm:text-base">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="18" cy="6" r="1" fill="currentColor" stroke="none" /></svg>
          Síguenos en Instagram ↗
        </a>
        <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-light">WhatsApp ↗</a>
      </div>
    </div>
    <form id="contact-form" class="grid gap-4 rounded-[1.7rem] bg-[#fcfbf7] p-6 text-stone-900 shadow-xl dark:bg-[#213a2a] dark:text-white sm:p-8">
      <h3 class="mb-2 border-b border-emerald-900/10 pb-4 text-center text-2xl font-extrabold text-[#14552d] dark:text-emerald-200">Formulario Asesoría</h3>
      <div><label for="contact-name" class="field-label">Nombre Completo</label><input class="input" id="contact-name" name="name" autocomplete="name" maxlength="80" required placeholder="Tu nombre..." /></div>
      <div><label for="contact-service" class="field-label">Servicio requerido</label><select class="input" id="contact-service" name="service" required><option value="" disabled selected>Selecciona un servicio</option>{services.map((service) => <option value={service.name}>{service.name}</option>)}<option value="Consulta general">Consulta general</option></select></div>
      <div><label for="contact-message" class="field-label">Mensaje</label><textarea class="input min-h-36 resize-y" id="contact-message" name="message" rows="5" minlength="15" maxlength="3000" required placeholder="¿En qué podemos ayudarte?"></textarea></div>
      <p class="text-xs text-stone-600 dark:text-stone-300"><a href="/privacidad/" class="underline hover:text-emerald-700">Información de privacidad</a></p>
      <button type="submit" class="btn w-full rounded-xl bg-[#079b49] font-bold text-white hover:bg-[#087b3d]">Continuar en WhatsApp ↗</button>
      <p class="text-center text-xs text-stone-600 dark:text-stone-300">Se abrirá WhatsApp con tu consulta lista. Presiona Enviar para completar la solicitud.</p>
      <noscript><p class="text-center text-sm"><a href={whatsappUrl()} class="underline">Contactar directamente por WhatsApp</a></p></noscript>
    </form>
  </div>
</section>
<script>
  import { whatsappUrl } from '../../config/site';
  import { buildWhatsAppInquiry } from '../../lib/whatsapp-message.mjs';

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const message = buildWhatsAppInquiry({
      name: String(data.get('name') ?? ''),
      service: String(data.get('service') ?? ''),
      message: String(data.get('message') ?? ''),
    });
    window.location.assign(whatsappUrl(message));
  });
</script>
