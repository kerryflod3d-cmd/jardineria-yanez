---
import { mediaPath, posterPath, services } from '../../data/services';
---
<section id="servicios" class="bg-[#fcfbf7] py-18 dark:bg-[#15271e] sm:py-24" aria-labelledby="services-title">
  <div class="container-site">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div>
        <h2 id="services-title" class="section-title">Nuestros servicios</h2>
        <p class="section-lead">Ofrecemos soluciones integrales para el cuidado de tus áreas verdes con profesionalismo y dedicación.</p>
      </div>
      <a href="#contacto" class="inline-flex shrink-0 items-center gap-2 text-base font-bold text-emerald-800 underline underline-offset-4 hover:text-emerald-600 dark:text-emerald-300">Consultar disponibilidad ↗</a>
    </div>
    <div class="mt-11 grid gap-7 md:grid-cols-2 lg:gap-8">
      {services.map((service) => <article data-carousel class:list={["flex min-w-0 flex-col overflow-hidden rounded-[1.8rem] border border-[#d9e5d7] bg-[#f5f5dc] shadow-sm dark:border-white/10 dark:bg-[#1c3226]", service.id === 'ligustrinas' ? 'md:col-span-2' : '']}>
        <div class="px-5 pt-5 sm:px-7 sm:pt-7">
          <div class="flex items-start gap-3">
            <span aria-hidden="true" class="text-3xl">{service.icon}</span>
            <div class="min-w-0"><h3 class="text-xl font-extrabold leading-snug text-[#173d2b] dark:text-white sm:text-2xl">{service.name}</h3><p class="mt-2 leading-7 text-stone-600 dark:text-stone-300">{service.description}</p></div>
          </div>
        </div>
        <div class="mt-5 min-w-0 px-5 sm:px-7">
          <div data-carousel-track tabindex="0" role="region" aria-roledescription="carrusel" aria-label={`Fotografías y videos de ${service.name}. Desliza horizontalmente para verlos en orden.`} class="media-carousel flex snap-x snap-mandatory gap-3 overflow-x-auto pb-2 sm:gap-4">
            {service.media.map((item) => <figure class="w-[83%] shrink-0 snap-start overflow-hidden rounded-xl sm:w-[76%] md:w-[82%] lg:w-[72%]">
              <button
                type="button"
                data-media-open
                data-media-src={mediaPath(item, 1600)}
                data-media-type={item.type}
                data-media-alt={item.alt}
                data-media-poster={item.type === 'video' ? posterPath(item) : undefined}
                aria-label={item.type === 'video' ? `Reproducir video ampliado: ${item.alt}` : `Ampliar imagen: ${item.alt}`}
                class="group relative block w-full cursor-zoom-in overflow-hidden rounded-xl focus-visible:outline-offset-[-3px]"
              >
                <img
                  src={item.type === 'video' ? posterPath(item) : mediaPath(item, 560)}
                  width="560" height="380" loading="lazy" decoding="async" alt={item.alt}
                  draggable="false"
                  class="aspect-[5/4] w-full select-none object-cover transition-transform duration-300 group-hover:scale-[1.025]"
                />
                {item.type === 'video'
                  ? <span aria-hidden="true" class="absolute inset-0 grid place-items-center bg-black/15"><span class="grid h-14 w-14 place-items-center rounded-full border border-white/80 bg-[#143723]/85 pl-1 text-2xl text-white shadow-lg">▶</span></span>
                  : <span aria-hidden="true" class="absolute right-3 bottom-3 rounded-full bg-black/55 px-3 py-1.5 text-xs font-semibold text-white opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">Ampliar ↗</span>}
              </button>
            </figure>)}
          </div>
          <div class="flex items-center justify-between gap-3 py-4">
            <p class="text-xs font-semibold text-stone-500 dark:text-stone-300 sm:text-sm"><span data-carousel-count>1 de {service.media.length}</span> <span class="ml-1 text-stone-400">· Desliza para explorar</span></p>
            <div class="flex gap-2"><button data-carousel-prev type="button" aria-label={`Imagen anterior de ${service.name}`} class="carousel-arrow" disabled>←</button><button data-carousel-next type="button" aria-label={`Imagen siguiente de ${service.name}`} class="carousel-arrow">→</button></div>
          </div>
        </div>
      </article>)}
    </div>
  </div>
  <dialog id="media-viewer" class="media-viewer w-[min(96vw,1280px)] max-w-none rounded-2xl border border-white/15 bg-[#101b15] p-0 text-white shadow-2xl" aria-label="Visor de fotos y videos de nuestros servicios">
    <div class="relative flex max-h-[96dvh] flex-col items-center justify-center px-2 pt-14 pb-4 sm:px-5">
      <button id="media-viewer-close" type="button" aria-label="Cerrar imagen o video ampliado" class="absolute top-2 right-3 z-10 grid h-11 w-11 place-items-center rounded-full border border-white/30 bg-black/65 text-2xl text-white hover:bg-black focus-visible:outline-offset-[-3px]">×</button>
      <img id="media-viewer-image" alt="" class="hidden max-h-[calc(96dvh-125px)] max-w-full rounded-lg object-contain" />
      <video id="media-viewer-video" class="hidden max-h-[calc(96dvh-125px)] max-w-full rounded-lg object-contain" controls playsinline preload="metadata"></video>
      <p id="media-viewer-caption" class="mt-3 max-w-2xl px-2 text-center text-sm text-white/85"></p>
    </div>
  </dialog>
</section>
<script>
  import { initCarousels } from '../../lib/carousels';
  import { initMediaViewer } from '../../lib/media-viewer';
  initCarousels();
  initMediaViewer();
</script>
