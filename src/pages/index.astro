---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Services from '../components/Services.astro';
import Testimonials from '../components/Testimonials.astro';
import Coverage from '../components/Coverage.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import orilladoraImg from '../assets/Orilladora.jpg';
import Coverage from '../components/Coverage.astro';
---

<Layout title="Jardinería Yañez | Expertos en áreas verdes">
	<Navbar />

	<!-- Sección Principal (Hero) con imagen de fondo -->
<header class="relative min-h-[85vh] flex flex-col pt-28 pb-16 text-center px-4 overflow-hidden bg-cover bg-center" style={`background-image: url('${orilladoraImg.src}');`}>
    <!-- Overlay oscuro para mejorar la legibilidad del texto -->
    <div class="absolute inset-0 bg-black/60"></div>

    <div class="max-w-4xl mx-auto relative z-10 text-white flex flex-col h-full flex-1 w-full">
        
        <!-- Bloque Superior: Título y Párrafo -->
        <div>
            <h1 class="flex flex-col items-center justify-center text-center font-extrabold text-5xl md:text-6xl tracking-tight space-y-2 mb-6">
                <span class="relative flex items-center justify-center text-green-900 drop-shadow-sm">
                    <span class="absolute -left-12 md:-left-16 text-4xl">🌲</span>
                    Creciendo
                </span>

                <span class="text-green-500">
                    tu Jardín,
                </span>

                <span class="text-green-900 drop-shadow-sm">
                    Cuidando
                </span>

                <span class="relative flex items-center justify-center text-green-500">
                    tu Hogar
                    <span class="absolute -right-12 md:-right-16 text-4xl">🌲</span>
                </span>
            </h1>
            
            <p class="text-xl text-gray-200 max-w-2xl mx-auto drop-shadow-md">
                Diseño, mantenimiento y cuidado profesional de áreas verdes. Transforma tu espacio exterior en un oasis de paz y naturaleza.
            </p>
        </div>

        <!-- Bloque Inferior: Botones (mt-auto los empuja hacia abajo) -->
        <div class="mt-auto pt-16 flex flex-col sm:flex-row justify-center gap-4">
            <a href="#contacto" class="bg-green-600 text-white px-8 py-4 rounded-full font-bold text-lg hover:bg-green-700 shadow-xl transition-all hover:scale-105 inline-block">
                Solicitar Presupuesto Gratis
            </a>
            <a href="#servicios" class="bg-white/10 backdrop-blur-md text-white border-2 border-white/40 px-8 py-4 rounded-full font-bold text-lg hover:bg-white/20 transition-all inline-block">
                Ver Servicios
            </a>
        </div>
    </div>
</header>

	<main>
		<Services />
        <Testimonials />
        <Coverage />
        <Contact />
	</main>

    <Footer />
</Layout>
